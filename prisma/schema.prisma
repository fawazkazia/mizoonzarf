// Premium Fashion E-Commerce — Phase 1 schema
// Models the full entity set from the product spec so later phases (admin, payments,
// loyalty, analytics) don't require breaking migrations. Tables marked "unused in Phase 1"
// exist for forward compatibility but have no UI/logic wired to them yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  SUPER_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  MARKETING_MANAGER
  CUSTOMER_SUPPORT
  INVENTORY_MANAGER
  BUSINESS_OWNER
  FINANCE
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  RAZORPAY
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  TABBY
  TAMARA
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP
  RECEIVED
  REFUND_PROCESSING
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum PromotionType {
  FLASH_SALE
  CATEGORY_SALE
  PRODUCT_SALE
  SEASONAL
}

enum BannerPosition {
  HERO
  PROMO
  CATEGORY
  POPUP
}

enum BannerTextSize {
  SMALL
  MEDIUM
  LARGE
}

/// CSS object-position preset for homepage/admin image fields — a cheap
/// alternative to full crop/focal-point tooling. Null means "use the
/// component's own default" (each consumer picks its own fallback).
enum ObjectPosition {
  CENTER
  TOP
  BOTTOM
  LEFT
  RIGHT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  ORDER_STATUS
  RETURN_STATUS
  BACK_IN_STOCK
  PRICE_DROP
  PROMOTION
  LOYALTY
}

enum BarcodeType {
  CODE128
  EAN13
  UPC_A
  QR
}

enum BarcodeSource {
  GENERATED
  MANUFACTURER
}

enum StockMovementType {
  RECEIVE
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED_RELEASE
  RETURN_RESTOCK
  RETURN_DAMAGED
  TRANSFER_OUT
  TRANSFER_IN
}

enum ScanContext {
  GENERAL_SEARCH
  RECEIVING
  ORDER_PACKING
  RETURN
  STOCK_ADJUST
}

enum ReturnResolution {
  RESTOCK
  DAMAGED
  EXCHANGE
  REFUND
  INSPECTION_REQUIRED
}

enum OtpPurpose {
  PHONE_VERIFY
  COD_RISK_CONFIRM
}

enum RiskLevel {
  LOW
  NORMAL
  HIGH
}

enum ReliabilityStatus {
  TRUSTED
  NORMAL
  HIGH_RISK
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  SALARIES
  MARKETING
  UTILITIES
  SOFTWARE_SUBSCRIPTIONS
  SHIPPING_LOGISTICS
  BANK_FEES
  OFFICE_SUPPLIES
  PROFESSIONAL_FEES
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

/// Generic tag for what produced a JournalEntry — keeps that model decoupled from every
/// possible source table instead of one nullable FK column per source type, which would
/// need a new migration every time a new postable event is added.
enum FinanceSourceType {
  ORDER_PAYMENT
  ORDER_REFUND
  PURCHASE_ORDER_RECEIPT
  EXPENSE
  CASH_COLLECTED
  SUPPLIER_PAYMENT
  MANUAL_ADJUSTMENT
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Which login surface a password-reset token was issued for — checked again at redemption
/// time against the account's *current* role so a token can never cross the customer/admin
/// boundary, even if the account's role changed between request and redemption.
enum PasswordResetPurpose {
  CUSTOMER
  ADMIN
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  /// Bumped on every successful password reset — existing JWT sessions issued before this
  /// timestamp are rejected (see jwt() callback in src/lib/auth.ts).
  passwordChangedAt DateTime?
  /// Set at registration when the customer checks "I agree to the Terms & Conditions" — proof
  /// of consent. Never retroactively required of accounts created before this field existed.
  termsAcceptedAt DateTime?
  phone         String?
  notes         String?   @db.Text
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Set only once the `phone` above has completed OTP verification — cleared implicitly whenever `phone` changes (a new number always re-verifies).
  phoneVerifiedAt DateTime?

  /// Computed by recomputeUserReliability() on order status transitions — see src/lib/risk/recomputeReliability.ts.
  reliabilityStatus       ReliabilityStatus  @default(NORMAL)
  reliabilityUpdatedAt    DateTime?
  /// Manual admin override — when set, takes precedence over reliabilityStatus everywhere and is never touched by recomputation.
  reliabilityOverride     ReliabilityStatus?
  reliabilityOverrideNote String?
  reliabilityOverrideBy   String?
  reliabilityOverrideAt   DateTime?

  accounts                 Account[]
  sessions                 Session[]
  addresses                Address[]
  orders                   Order[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
  cart                     Cart?
  auditLogs                AuditLog[]
  loyaltyAccount           LoyaltyAccount?
  referralsMade            Referral[]                @relation("Referrer")
  notifications            Notification[]
  stockMovements           StockMovement[]
  barcodeScanLogs          BarcodeScanLog[]
  barcodePrintLogs         BarcodePrintLog[]
  barcodeDuplicateAttempts BarcodeDuplicateAttempt[]
  phoneOtps                PhoneOtp[]
  verifiedPhones           VerifiedPhone[]
  emailLogs                EmailLog[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

/// Password-reset tokens for both customer and admin accounts (same User table). Only a
/// SHA-256 hash of the raw token is stored — the raw token exists solely in the emailed link.
model PasswordResetToken {
  id          String               @id @default(cuid())
  userId      String
  tokenHash   String               @unique
  purpose     PasswordResetPurpose
  expiresAt   DateTime
  usedAt      DateTime?
  requesterIp String?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Every forgot-password POST (whether or not the email matches an account) — used only to
/// rate-limit requests, since a real PasswordResetToken can't be created for an unknown email.
model PasswordResetAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("password_reset_attempts")
}

/// OTP codes + rate-limit ledger for mobile verification (see src/lib/otp/otp.ts). Codes are always bcrypt-hashed, never stored plaintext.
model PhoneOtp {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  userId      String?
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  requesterIp String?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@index([requesterIp, createdAt])
  @@map("phone_otps")
}

/// Durable "this phone number is verified" ledger, covering both accounts (userId set) and guest checkouts
/// (userId null, identified instead by guestToken). Source of truth for the "multiple accounts, same phone"
/// risk signal — see src/lib/risk/computeOrderRisk.ts.
model VerifiedPhone {
  id         String    @id @default(cuid())
  phone      String
  userId     String?
  guestToken String?   @unique
  verifiedAt DateTime  @default(now())
  /// Null for account-linked rows (persist indefinitely); set (~7 days) for guest rows.
  expiresAt  DateTime?
  orderId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([userId])
  @@map("verified_phones")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Catalog ----------

model Category {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String?
  imageUrl            String?
  gender              Gender?
  parentId            String?
  sortOrder           Int             @default(0)
  isActive            Boolean         @default(true)
  showInMenu          Boolean         @default(true)
  attributeSchema     Json?
  seoTitle            String?
  seoDescription      String?
  imageObjectPosition ObjectPosition?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logoUrl     String?
  description String?

  products Product[]

  @@map("brands")
}

model Collection {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String?
  imageUrl            String?
  imageObjectPosition ObjectPosition?
  isActive            Boolean         @default(true)
  startDate           DateTime?
  endDate             DateTime?
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())

  products Product[] @relation("CollectionProducts")

  @@map("collections")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  brandId          String?
  categoryId       String
  description      String        @db.Text
  shortDescription String?
  videoUrl         String?
  basePrice        Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  gender           Gender
  material         String?
  fitInfo          String?
  careInstructions String?
  sizeGuideType    String?
  fragranceFamily  String?
  fragranceNotes   Json?
  concentration    String?
  tags             String[]      @default([])
  attributes       Json?
  gstRate          Decimal?      @db.Decimal(5, 2)
  hsnCode          String?
  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  viewCount        Int           @default(0)
  purchaseCount    Int           @default(0)
  avgRating        Float         @default(0)
  reviewCount      Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand             Brand?                    @relation(fields: [brandId], references: [id])
  category          Category                  @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  variantAttributes ProductVariantAttribute[]
  images            ProductImage[]
  reviews           Review[]
  wishlisted        WishlistItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  collections       Collection[]              @relation("CollectionProducts")

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

/// Product-scoped, ordered variant attribute definitions (e.g. "Size", "Colour", "Waist") —
/// lets each product declare its own set of variant axes instead of a hardcoded Size+Colour pair.
model ProductVariantAttribute {
  id        String   @id @default(cuid())
  productId String
  name      String
  isColor   Boolean  @default(false)
  position  Int      @default(0)
  /// Ordered value pool for this axis: [{ value: string, hex?: string }]. Recomputed server-side
  /// from the product's actual variants on every save — never trust this as client-authoritative.
  values    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_variant_attributes")
}

/// Global, reusable pool of values seen for each attribute name (e.g. "Size" -> S/M/L/XL) so the
/// admin can pick from values used on past products instead of retyping them on every new one.
/// One row per attribute name; not product-scoped. Populated additively — adding a value here
/// never removes it from elsewhere, and removing a value from one product's variant list does
/// not touch this pool (other products may still rely on it).
model AttributeValueLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  isColor   Boolean  @default(false)
  /// Ordered value pool: [{ value: string, hex?: string }], deduped case-insensitively by value.
  values    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attribute_value_library")
}

model ProductVariant {
  id                 String         @id @default(cuid())
  productId          String
  sku                String         @unique
  barcode            String?        @unique
  barcodeType        BarcodeType?
  barcodeSource      BarcodeSource?
  barcodeGeneratedAt DateTime?
  size               String?
  color              String?
  colorHex           String?
  /// Ordered [{ name, value, hex? }] — the canonical attribute combination for this variant.
  /// `size`/`color`/`colorHex` above are auto-derived mirrors kept in sync for legacy readers
  /// (catalog facets/filters) and pre-migration rows; write code should treat this field as the
  /// source of truth and always recompute the mirrors from it.
  attributeValues    Json           @default("[]")
  price              Decimal        @db.Decimal(10, 2)
  salePrice          Decimal?       @db.Decimal(10, 2)
  /// Last-cost basis (most recent PO receipt's unitCost) — used for COGS. Null until first
  /// received/manually set. See OrderItem.costPriceSnapshot for the point-in-time value used
  /// on historical orders, which must never move when this changes later.
  costPrice          Decimal?       @db.Decimal(10, 2)
  stock              Int            @default(0)
  reservedStock      Int            @default(0)
  lowStockThreshold  Int            @default(5)
  imageUrl           String?
  isDefault          Boolean        @default(false)
  /// Per-unit shipping weight in grams — falls back to the configured default package weight when unset.
  weightGrams        Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems           CartItem[]
  orderItems          OrderItem[]
  warehouseStocks     VariantWarehouseStock[]
  stockMovements      StockMovement[]
  scanLogs            BarcodeScanLog[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String?
  customerName       String
  rating             Int
  title              String?
  comment            String   @db.Text
  images             String[] @default([])
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

/// In-app notification center — distinct from NotificationTemplate (which
/// renders outbound EMAIL/SMS content). One row per recipient; no separate
/// "read" join table, so broadcast-style notices (PROMOTION) are fanned out
/// as one row per targeted user at creation time rather than referenced.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------- Cart ----------

model Cart {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionToken String?  @unique
  couponCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------- Orders ----------

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  country    String   @default("IN")
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String?
  guestEmail       String?
  guestPhone       String?
  status           OrderStatus   @default(ORDER_PLACED)
  subtotal         Decimal       @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  cgstAmount       Decimal       @default(0) @db.Decimal(10, 2)
  sgstAmount       Decimal       @default(0) @db.Decimal(10, 2)
  igstAmount       Decimal       @default(0) @db.Decimal(10, 2)
  customerGstin    String?
  sellerGstin      String?
  sellerState      String?
  invoiceNumber    String?       @unique
  invoiceDate      DateTime?
  total            Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  couponCode       String?
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  deliveryMethod   String        @default("standard")
  shippingAddress  Json
  billingAddress   Json?
  notes            String?
  packingStartedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// Fraud-risk snapshot computed at checkout — see src/lib/risk/computeOrderRisk.ts. Never auto-rejects; admins act on it.
  riskLevel      RiskLevel @default(NORMAL)
  riskScore      Int       @default(0)
  riskReasons    String[]  @default([])
  /// Whether the contact phone was verified at the moment this order was placed (server-enforced, not just a UI flag).
  phoneVerified  Boolean   @default(false)
  /// Set when a HIGH-risk COD order was unlocked via COD_RISK_CONFIRM OTP re-verification.
  codConfirmedAt DateTime?

  user                User?                @relation(fields: [userId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  shipment            Shipment?
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]
  emailLogs           EmailLog[]
  invoices            Invoice[]
  refunds             Refund[]

  @@index([userId])
  @@index([status])
  @@index([riskLevel])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  variantId         String
  productName       String
  variantLabel      String?
  /// Structured snapshot of the variant's attributes at order time: [{ name, value, hex? }].
  /// Null on historical orders predating this field — those fall back to `variantLabel`.
  variantAttributes Json?
  sku               String
  price             Decimal @db.Decimal(10, 2)
  quantity          Int
  subtotal          Decimal @db.Decimal(10, 2)
  gstRate           Decimal @default(0) @db.Decimal(5, 2)
  hsnCode           String?
  packedQuantity    Int     @default(0)
  /// Frozen copy of ProductVariant.costPrice at order time — COGS must use this, never a live
  /// lookup, so later PO receipts don't retroactively change a historical order's profit.
  costPriceSnapshot Decimal? @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  returns Return[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       PaymentMethod
  status         PaymentStatus
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  transactionRef String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  carrier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// "MANUAL" (hand-entered carrier/tracking) or "SHIPROCKET" (provider-managed) — see src/lib/shipping/registry.ts.
  provider    String  @default("MANUAL")
  warehouseId String?

  shiprocketOrderId    String?
  shiprocketShipmentId String?
  awbCode              String?
  courierId            String?
  courierName          String?

  packageWeight Float?
  packageLength Float?
  packageWidth  Float?
  packageHeight Float?
  codAmount     Decimal? @db.Decimal(10, 2)

  labelUrl    String?
  manifestUrl String?

  pickupScheduledAt DateTime?
  pickupStatus      String?

  /// Granular carrier tracking status (raw Shiprocket status text) — coarse business status stays on Order.status.
  trackingStatus    String?
  /// Plain-language delivery exception (NDR / lost / damaged), surfaced to admin and customer.
  deliveryException String?

  lastApiStatus      String?
  lastApiResponse    Json?
  lastTrackingSyncAt DateTime?

  errorMessage String?
  retryCount   Int     @default(0)

  /// Guards against duplicate Shiprocket order creation from a retried automation trigger.
  idempotencyKey String? @unique

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  events    ShipmentEvent[]

  @@map("shipments")
}

/// Append-only granular tracking log — drives the detailed tracking timeline. OrderStatusHistory
/// stays the coarse business-status log; not every ShipmentEvent maps to an OrderStatus change.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  location   String?
  activity   String?
  occurredAt DateTime
  /// "WEBHOOK" | "POLL" | "MANUAL"
  source     String
  raw        Json?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, status, occurredAt])
  @@index([shipmentId])
  @@map("shipment_events")
}

/// Singleton row caching the Shiprocket login-derived bearer token across serverless invocations.
model ShiprocketToken {
  id        String   @id @default("singleton")
  token     String   @db.Text
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("shiprocket_tokens")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// Modeled per spec Section 48; no customer/admin UI wired to it in Phase 1.
model Return {
  id           String            @id @default(cuid())
  orderId      String
  orderItemId  String?
  reason       String
  description  String?
  images       String[]          @default([])
  status       ReturnStatus      @default(REQUESTED)
  refundAmount Decimal?          @db.Decimal(10, 2)
  adminNote    String?           @db.Text
  resolution   ReturnResolution?
  warehouseId  String?
  restockedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  refunds   Refund[]

  @@map("returns")
}

// ---------- Inventory & Barcodes ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Structured pickup-location details, used when this warehouse is registered as a Shiprocket pickup location.
  contactName              String?
  phone                    String?
  email                    String?
  addressLine2             String?
  city                     String?
  state                    String?
  country                  String? @default("IN")
  pincode                  String?
  shiprocketPickupLocation String?

  variantStocks  VariantWarehouseStock[]
  stockMovements StockMovement[]
  returns        Return[]
  shipments      Shipment[]
  purchaseOrders PurchaseOrder[]

  @@map("warehouses")
}

model VariantWarehouseStock {
  id          String @id @default(cuid())
  variantId   String
  warehouseId String
  quantity    Int    @default(0)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("variant_warehouse_stock")
}

model StockMovement {
  id            String            @id @default(cuid())
  variantId     String
  warehouseId   String
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  referenceType String?
  referenceId   String?
  userId        String?
  createdAt     DateTime          @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

model BarcodeScanLog {
  id        String      @id @default(cuid())
  barcode   String
  variantId String?
  found     Boolean
  context   ScanContext
  userId    String?
  createdAt DateTime    @default(now())

  variant ProductVariant? @relation(fields: [variantId], references: [id])
  user    User?           @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([barcode])
  @@map("barcode_scan_logs")
}

model BarcodePrintLog {
  id         String   @id @default(cuid())
  variantIds String[] @default([])
  labelCount Int
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("barcode_print_logs")
}

model BarcodeDuplicateAttempt {
  id        String   @id @default(cuid())
  barcode   String
  variantId String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("barcode_duplicate_attempts")
}

/// Atomic per-prefix sequence for internal barcode numbering — same race-safe
/// upsert pattern as InvoiceCounter (see generateInvoiceNumber in src/lib/orders/invoicing.ts).
model BarcodeCounter {
  id         String   @id @default(cuid())
  prefix     String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("barcode_counters")
}

// ---------- Suppliers & Purchasing ----------

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  gstin       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  invoices       Invoice[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  expectedAt  DateTime?
  sentAt      DateTime?
  approvedAt  DateTime?
  receivedAt  DateTime?
  closedAt    DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]
  invoices  Invoice[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  incurredAt  DateTime
  supplierId  String?
  /// Free-text bank/cash note for Phase A (e.g. "HDFC Current A/c") — not yet linked to an
  /// Account row; the debit side of the posted journal entry is always Cash & Bank (code 1000)
  /// regardless of this note, until a later phase adds real bank-account selection.
  paidFrom    String?
  createdById String?
  createdAt   DateTime        @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([category])
  @@index([incurredAt])
  @@map("expenses")
}

/// Configurable chart of accounts. Named LedgerAccount (not "Account") to avoid colliding with
/// the existing Auth.js Account model (OAuth account linking). `code` is the human-facing
/// ledger number (e.g. "4000"); `type` buckets it for P&L math. Seeded with a default set (see
/// prisma/seed.ts) but editable via /admin/finance/chart-of-accounts — new accounts are just
/// new rows, never a migration.
model LedgerAccount {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  type     AccountType
  /// True for contra accounts (Sales Discounts, Sales Returns) that reduce their parent type's
  /// total instead of adding to it — P&L math subtracts these instead of summing them.
  isContra Boolean     @default(false)
  isActive Boolean     @default(true)
  createdAt DateTime   @default(now())

  journalLines JournalLine[]

  @@map("ledger_accounts")
}

/// Atomic global sequence for JournalEntry numbering — same race-safe upsert pattern as
/// InvoiceCounter/BarcodeCounter (see generateInvoiceNumber in src/lib/orders/invoicing.ts).
model JournalEntryCounter {
  id         String   @id @default("singleton")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("journal_entry_counters")
}

/// One posting event = one JournalEntry with >=2 balanced JournalLines (debits must equal
/// credits — enforced in src/lib/finance/ledger.ts before insert). `sourceType`+`sourceId`
/// generically link back to whatever business event produced this instead of one nullable FK
/// per source type — see the FinanceSourceType enum doc comment for why. The unique constraint
/// below is also the idempotency guard: a given (sourceType, sourceId, kind) can post once, ever.
model JournalEntry {
  id          String            @id @default(cuid())
  entryNumber String            @unique
  date        DateTime
  description String
  sourceType  FinanceSourceType
  sourceId    String
  /// Distinguishes multiple entries against the same source, e.g. an order gets both an
  /// "ORDER_PAID" entry and, later, an "ORDER_REFUND" reversal — same sourceId, different kind.
  kind        String
  createdById String?
  createdAt   DateTime          @default(now())

  lines JournalLine[]

  @@unique([sourceType, sourceId, kind])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(12, 2)
  credit    Decimal @default(0) @db.Decimal(12, 2)
  memo      String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// First-class invoice, distinct from Order.invoiceNumber/invoiceDate (which stay untouched —
/// the existing /admin/orders/[id]/invoice page keeps rendering off those directly). This is
/// the AR/AP system-of-record: SALES invoices link orderId; PURCHASE invoices link
/// purchaseOrderId+supplierId. Exactly one pairing is set, enforced in application code that
/// creates these rows (Prisma has no partial-FK CHECK to enforce it at the schema level).
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  type            InvoiceType
  status          InvoiceStatus @default(ISSUED)
  orderId         String?
  purchaseOrderId String?
  supplierId      String?
  issueDate       DateTime
  dueDate         DateTime?
  subtotal        Decimal       @db.Decimal(10, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  order         Order?         @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  refunds       Refund[]

  @@index([orderId])
  @@index([purchaseOrderId])
  @@map("invoices")
}

/// Unifies the two refund paths that used to be disconnected (order-level refundPayment vs.
/// the Return workflow) — one row per real financial reversal, whichever path triggered it.
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  returnId    String?
  paymentId   String?
  invoiceId   String?
  amount      Decimal      @db.Decimal(10, 2)
  reason      String?
  status      RefundStatus @default(PENDING)
  providerRef String?
  rawResponse Json?
  createdById String?
  createdAt   DateTime     @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  return  Return?  @relation(fields: [returnId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// ---------- Marketing ----------

model Coupon {
  code              String       @id
  description       String?
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderValue     Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int          @default(0)
  perCustomerLimit  Int?
  categorySlugs     String[]     @default([])
  productIds        String[]     @default([])
  customerIds       String[]     @default([])
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  @@map("coupons")
}

model Promotion {
  id            String        @id @default(cuid())
  name          String
  type          PromotionType
  discountType  DiscountType
  discountValue Decimal       @db.Decimal(10, 2)
  categorySlugs String[]      @default([])
  productIds    String[]      @default([])
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  bannerText    String?
  createdAt     DateTime      @default(now())

  @@map("promotions")
}

model Banner {
  id                  String          @id @default(cuid())
  title               String
  subtitle            String?
  titleColor          String?
  subtitleColor       String?
  titleSize           BannerTextSize  @default(MEDIUM)
  /// Percentage (0-100) placement of the title/subtitle/button block over the
  /// desktop image, set via the admin drag-to-position picker. Null on both
  /// means "use the component's default layout" — mobile always ignores these
  /// and keeps its fixed stacked layout regardless.
  contentPositionX    Float?
  contentPositionY    Float?
  imageUrl            String
  mobileImageUrl      String?
  imageObjectPosition ObjectPosition?
  ctaText             String?
  ctaLink             String?
  position            BannerPosition
  sortOrder           Int             @default(0)
  startDate           DateTime?
  endDate             DateTime?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())

  @@index([position])
  @@map("banners")
}

/// Ordering/visibility for homepage sections — read by the storefront home page today;
/// a drag-and-drop admin editor over this table is Phase 2's website builder.
model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  config    Json?
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("newsletter_subscribers")
}

model SearchLog {
  id             String   @id @default(cuid())
  term           String   @unique
  count          Int      @default(1)
  lastSearchedAt DateTime @updatedAt

  @@map("search_logs")
}

// ---------- Configuration ----------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Atomic per-financial-year sequence for GST-compliant invoice numbering.
/// Assigned only once an order is paid — see generateInvoiceNumber() in
/// src/lib/orders/invoicing.ts. Never assign numbers by reading-then-writing
/// lastNumber outside that helper's upsert — that's the only race-safe path.
model InvoiceCounter {
  id            String   @id @default(cuid())
  financialYear String   @unique
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("invoice_counters")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String   @id @default(cuid())
  loyaltyAccountId String
  orderId          String?
  points           Int
  type             String
  description      String?
  createdAt        DateTime @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id])

  @@map("loyalty_transactions")
}

// ---------- Deferred (Phase 5) — modeled, no UI/logic wired yet ----------

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  code          String   @unique
  referredEmail String?
  status        String   @default("PENDING")
  rewardAmount  Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

/// Modeled per spec Section 49. Phase 3 renders these for real Email/SMS sends
/// (see src/lib/notifications/templates.ts); WhatsApp uses Meta-approved
/// message templates instead (managed in Meta Business Manager, not here).
model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String
  channel   NotificationChannel
  subject   String?
  body      String              @db.Text
  variables String[]            @default([])
  isActive  Boolean             @default(true)

  @@unique([key, channel])
  @@map("notification_templates")
}

enum EmailStatus {
  SENT
  FAILED
}

/// One row per branded transactional email actually attempted (order/return/tracking
/// events + admin test sends) — powers the admin "Email Notifications" history/retry UI.
/// Stores the fully-rendered subject/HTML so a retry can resend byte-for-byte without
/// re-deriving order state that may have since changed.
model EmailLog {
  id                String      @id @default(cuid())
  orderId           String?
  userId            String?
  toEmail           String
  notificationType  String
  subject           String
  htmlBody          String      @db.Text
  status            EmailStatus
  errorMessage      String?     @db.Text
  providerMessageId String?
  isTest            Boolean     @default(false)
  retryCount        Int         @default(0)
  lastRetriedAt     DateTime?
  createdAt         DateTime    @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}
