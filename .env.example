# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev: `npx prisma dev` prints a ready-to-use connection string.
# Production: use a managed Postgres (Neon, Supabase, RDS, etc.).
DATABASE_URL="postgresql://user:password@localhost:5432/fashion_store?schema=public"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp -----------------------------------------------------------------
# Shown in the storefront (footer, WhatsApp CTA, product enquiry) even before
# the WhatsApp Business API is connected in Phase 3.
NEXT_PUBLIC_WHATSAPP_NUMBER="971500000000"

# =============================================================================
# PHASE 3 — Payments (not yet wired; the checkout UI shows these as
# "Coming Soon" until a real provider key is present). Uncomment and fill in
# the provider(s) you plan to enable, then implement the matching adapter in
# src/lib/payments/*.ts following the CashOnDeliveryProvider pattern.
# =============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NETWORK_INTERNATIONAL_API_KEY=
# TELR_STORE_ID=
# TELR_AUTH_KEY=
# TABBY_SECRET_KEY=
# TABBY_PUBLIC_KEY=
# TAMARA_API_TOKEN=
# APPLE_PAY_MERCHANT_ID=
# GOOGLE_PAY_MERCHANT_ID=

# =============================================================================
# PHASE 3 — Notifications (WhatsApp / SMS / Email). Until these are set, the
# notification service logs to the server console instead of sending
# (see src/lib/notifications/console.ts).
# =============================================================================
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# =============================================================================
# Storage (product image/video uploads — Phase 2 admin panel)
# =============================================================================
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# =============================================================================
# PHASE 4 — AI (Style Assistant, AI marketing/banner copy). The service
# interface lives in src/lib/ai/provider.ts; nothing calls it yet.
# =============================================================================
# ANTHROPIC_API_KEY=

# =============================================================================
# Analytics & Marketing Pixels (wire into layout.tsx when ready)
# =============================================================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
