# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---------------------------------------------------
# Local dev: a real Postgres running in Docker (see docker-compose.yml).
#   1. Fill in POSTGRES_PASSWORD below with your own value.
#   2. docker compose up -d
#   3. npx prisma migrate deploy
# Production: use a managed Postgres (Neon, Supabase, RDS, etc.) — just swap
# DATABASE_URL, everything else (schema, migrations, Prisma Client) is unchanged.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-long-random-string"
POSTGRES_DB="fashion_app"
POSTGRES_PORT="5432"

DATABASE_URL="postgresql://postgres:replace-with-a-long-random-string@localhost:5432/fashion_app?schema=public"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp -----------------------------------------------------------------
# Shown in the storefront (footer, WhatsApp CTA, product enquiry) even before
# the WhatsApp Business API is connected in Phase 3.
NEXT_PUBLIC_WHATSAPP_NUMBER="919500000000"

# =============================================================================
# Payments (not yet wired; the checkout UI shows these as "Coming Soon" until
# a real provider key is present). Uncomment and fill in the provider(s) you
# plan to enable, then implement the matching adapter in src/lib/payments/*.ts
# following the CashOnDeliveryProvider pattern.
# =============================================================================
# Razorpay — primary India gateway (UPI, cards, RuPay, net banking, wallets
# are all presented inside Razorpay's own Checkout.js widget). Get keys from
# the Razorpay Dashboard > Settings > API Keys; the webhook secret is set
# when you register https://<your-domain>/api/webhooks/razorpay as a webhook
# subscribed to payment.captured and payment.failed.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NETWORK_INTERNATIONAL_API_KEY=
# TELR_STORE_ID=
# TELR_AUTH_KEY=
# TABBY_SECRET_KEY=
# TABBY_PUBLIC_KEY=
# TAMARA_API_TOKEN=
# APPLE_PAY_MERCHANT_ID=
# GOOGLE_PAY_MERCHANT_ID=

# =============================================================================
# Shipping — Shiprocket (src/lib/shipping/*.ts). Until SHIPROCKET_EMAIL/
# SHIPROCKET_PASSWORD (or SHIPROCKET_API_TOKEN) is set, Admin -> Shipping shows
# "Not Configured" and the active provider must stay "Manual". Configure the
# rest (pickup location, COD/prepaid, automation) in Admin -> Shipping once
# credentials are set — those are non-secret and live in the Setting table,
# not here.
# =============================================================================
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_API_TOKEN=        # optional: skip email/password login, use a manually-obtained token directly
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_MODE=test         # "test" (default; dry-runs order/AWB/label/pickup/cancel calls) | "production"
# SHIPROCKET_WEBHOOK_SECRET=   # must match the header token you set in Shiprocket's webhook config for https://<your-domain>/api/webhooks/shiprocket
# CRON_SECRET=                 # bearer token protecting /api/cron/shiprocket-sync (the tracking-sync fallback poll)

# =============================================================================
# PHASE 3 — Notifications (WhatsApp / SMS / Email). Until these are set, the
# notification service logs to the server console instead of sending
# (see src/lib/notifications/console.ts).
# =============================================================================
# WhatsApp Business Cloud API requires message templates created and approved
# in Meta Business Manager (name must match the templateKey — see
# src/lib/notifications/whatsapp.ts) before it can send anything.
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=
# WHATSAPP_TEMPLATE_LANG=en
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# =============================================================================
# Checkout — address search & "Use My Current Location" (Google Maps Platform)
# Enable "Places API" and "Geocoding API" for your project in Google Cloud
# Console, then create an API key restricted to those two APIs (server-side
# only — this key is never sent to the browser; requests are proxied through
# our own /api/geo/* routes). Until this is set, the checkout address section
# falls back gracefully to manual entry (no search box / "Use My Current
# Location" button — country/state pickers and validation still work fully
# offline via the bundled country-state-city dataset).
# =============================================================================
# GOOGLE_MAPS_API_KEY=

# =============================================================================
# Storage (product image/video uploads — Phase 2 admin panel)
# =============================================================================
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# =============================================================================
# AI Shopping Assistant ("Help Me Choose") — fully wired (src/lib/ai/provider.ts,
# /api/ai/assistant). Without a key set, the launcher renders disabled with a
# "Coming Soon" label instead of a broken chat. Set this to enable it for real.
# =============================================================================
# OPENAI_API_KEY=

# =============================================================================
# Analytics & Marketing Pixels (wire into layout.tsx when ready)
# =============================================================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
